{
  "name": "colorpencil-erp",
  "version": "1.13.18",
  "description": "색연필 제조 수주·생산·재고·원부자재 ERP / ERP bút chì màu",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "demo": "node tools/build_demo.js",
    "dist": "electron-builder --win dir --x64 && makensis -DVERSION=1.13.18 build/installer.nsi",
    "test": "node tools/selftest_import.js",
    "test:assistant": "node tools/selftest_assistant.js",
    "test:v7": "node tools/selftest_v7.js",
    "test:v8": "node tools/selftest_v8.js",
    "test:v9": "node tools/selftest_v9.js",
    "test:v11": "node tools/selftest_v11.js",
    "test:v12": "node tools/selftest_v12.js",
    "test:v13": "node tools/selftest_v13.js",
    "test:v14": "node tools/selftest_v14.js",
    "test:v15": "node tools/selftest_v15.js",
    "test:v16": "node tools/selftest_v16.js",
    "test:v17": "node tools/selftest_v17.js",
    "test:v18": "node tools/selftest_v18.js",
    "test:electron": "node tools/smoke_electron.js",
    "seed:v6": "node tools/build_seed_v6.js"
  },
  "keywords": [],
  "author": "Factory ERP",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "chart.js": "^4.4.4",
    "xlsx": "^0.18.5"
  },
  "productName": "ColorPencil ERP",
  "private": true,
  "build": {
    "appId": "com.factory.colorpencil.erp",
    "productName": "ColorPencil ERP",
    "copyright": "Factory ERP",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "server.js",
      "cloudsync.js",
      "google/**",
      "app/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ColorPencil ERP",
      "language": "1042",
      "installerLanguages": [
        "ko_KR"
      ],
      "deleteAppDataOnUninstall": false,
      "artifactName": "ColorPencil-ERP-Setup-${version}.exe"
    }
  }
}
