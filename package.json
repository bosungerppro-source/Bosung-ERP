{
  "name": "colorpencil-erp",
  "version": "1.2.0",
  "description": "색연필 제조 수주·생산·재고·원부자재 ERP / ERP bút chì màu",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "demo": "node tools/build_demo.js",
    "dist": "electron-builder --win dir --x64 && makensis -DVERSION=1.2.0 build/installer.nsi",
    "test": "node tools/selftest_import.js",
    "test:assistant": "node tools/selftest_assistant.js",
    "test:v7": "node tools/selftest_v7.js",
    "test:v8": "node tools/selftest_v8.js",
    "seed:v6": "node tools/build_seed_v6.js"
  },
  "keywords": [],
  "author": "Factory ERP",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "chart.js": "^4.4.4",
    "xlsx": "^0.18.5"
  },
  "productName": "ColorPencil ERP",
  "private": true,
  "build": {
    "appId": "com.factory.colorpencil.erp",
    "productName": "ColorPencil ERP",
    "copyright": "Factory ERP",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "server.js",
      "app/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ColorPencil ERP",
      "language": "1042",
      "installerLanguages": [
        "ko_KR"
      ],
      "deleteAppDataOnUninstall": false,
      "artifactName": "ColorPencil-ERP-Setup-${version}.exe"
    }
  }
}
